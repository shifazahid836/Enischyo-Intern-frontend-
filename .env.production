# ---------------------------------------------------------------------------
# Production build defaults — committed on purpose.
#
# `vite build` loads this file automatically (mode = "production"), so the
# deployed bundle always points at the live API even when the hosting provider
# has no VITE_API_BASE_URL configured. `npm run dev` ignores it: development
# keeps using the /api proxy from vite.config.js.
#
# This value is NOT a secret — Vite inlines it into the public JavaScript
# bundle. Anything set in the host's dashboard still wins, because Vite gives
# real environment variables priority over .env files.
#
# The /api suffix is required: src/api/client.js appends paths such as
# "/jobs" and "/auth/login" to this value, and the API mounts every resource
# under both "/" and "/api".
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://enischyo-intern-backend.vercel.app/api
