# ─── Frontend environment variables (Vite) ────────────────────────────────────
#
# Copy this file to `.env` when you need to override the defaults.
#
# VITE_API_BASE_URL
#   Base URL of the Job Board API.
#
#   • Development (default): leave it as /api.
#     vite.config.js proxies every /api/* request to http://localhost:5000,
#     so the browser talks to the Vite dev server and CORS never comes into
#     play at all.
#
#   • Production / deployed API: use the full URL, including /api, e.g.
#         VITE_API_BASE_URL=https://my-job-api.onrender.com/api
#
VITE_API_BASE_URL=/api
